<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground: a tablet in landscape with a corner-to-corner resize arrow on its
  screen. Everything sits inside the middle 66 of the 108 canvas, the part no launcher crops.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Tablet body, 16:10 like the Pad's screen. -->
    <path
        android:pathData="M30,35H78a6,6 0,0 1,6 6V67a6,6 0,0 1,-6 6H30a6,6 0,0 1,-6 -6V41a6,6 0,0 1,6 -6z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />
    <!-- Resize arrow: the diagonal, then a corner at each end. -->
    <path
        android:pathData="M39,62.5L69,45.5M59,45H70V56M49,63H38V52"
        android:strokeColor="#FF8CF2E0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />
</vector>
